# Use development locally. Production requires HTTPS, strong secrets and a managed database.
APP_ENV=development
DATABASE_URL=sqlite:///./veyra.db
ADMIN_API_TOKEN=replace-this-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for customer login sessions; generate a unique random secret of at least 32 characters.
CUSTOMER_TOKEN_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Milestone 12 email notifications (disabled by default). Use SMTP credentials from your mail provider.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VEYRA
SMTP_USE_TLS=true
